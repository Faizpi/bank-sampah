# Local development defaults. Do not use this file as a production secret store.
APP_NAME="Bank Sampah Digital Sindangheula"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# Production contract (set in the host's private environment, never commit the values):
# APP_ENV=production
# APP_KEY=<stable-generated-key-stored-out-of-band>
# APP_DEBUG=false
# APP_URL=https://<application-domain>
# GOOGLE_SITE_VERIFICATION=<token-from-google-search-console>
# APP_TIMEZONE=Asia/Jakarta
# LOG_LEVEL=warning
# DB_CONNECTION=mariadb
# DB_HOST=<managed-database-host>
# DB_PORT=3306
# DB_DATABASE=<application-database>
# DB_USERNAME=<least-privilege-application-user>
# DB_PASSWORD=<database-secret>
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=database
# FILESYSTEM_DISK=local
# QUEUE_CONNECTION=sync
# OPERATIONS_QUEUE_WORKER_MODE=none
# SCHEDULER_TOPOLOGY=cron

# Initial production Admin uses APP_INITIAL_ADMIN_USERNAME and PASSWORD below.
# Bootstrap never overwrites an existing account or grants it new authority.
# Local seeding uses private data; extract the owner's SQL first (see docs/SEEDING.md).
# MASTER_SEED_PATH defaults to database/data/master-data.json (ignored by Git).
# APP_DEMO_MODE=true enables local login shortcuts; APP_DEMO_PASSWORD is optional.
# Never commit real secrets.

# Temporary shared-hosting installer; remove public/deploy.php after use.
HOSTING_DEMO_INSTALL_ENABLED=false
HOSTING_DEMO_DATABASE=
# For sibling /bank-sampah and /public_html only:
# DEPLOYMENT_LAYOUT=split
# DEPLOYMENT_DOCUMENT_ROOT=/home/CPANEL_USER/public_html
# Keep APP_ENV=production and APP_DEBUG=false; never copy the local APP_KEY.

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Optional protected web console at /deploy.php. Leave the token empty to keep it disabled.
# Generate and store the production token privately; never commit a real token.
DEPLOY_CONSOLE_TOKEN=
# Optional comma-separated trusted public IP addresses.
DEPLOY_CONSOLE_ALLOWED_IPS=

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bank_sampah_sindangheula
DB_USERNAME=bank_sampah_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

REGISTRATION_MAX_ATTEMPTS_PER_MINUTE=5
PUBLIC_QR_MAX_ATTEMPTS_PER_MINUTE=30
PUBLIC_DATA_MAX_ATTEMPTS_PER_MINUTE=120
UPLOAD_MAX_ATTEMPTS_PER_MINUTE=10
EXPORT_MAX_ATTEMPTS_PER_MINUTE=10
FINANCIAL_REQUEST_MAX_ATTEMPTS_PER_MINUTE=10
DEPOSIT_MAX_ITEM_WEIGHT_KG=50
DEPOSIT_MAX_TOTAL_WEIGHT_KG=100

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
DB_QUEUE_MAX_JOBS=25
DB_QUEUE_MAX_TIME=55
DB_QUEUE_TRIES=3
OPERATIONS_SCHEDULER_BATCH_SIZE=50
OPERATIONS_NOTIFICATION_FAILURE_RETENTION_HOURS=168
OPERATIONS_PICKUP_PHOTO_MINIMUM_AGE_DAYS=30
OPERATIONS_PICKUP_PHOTO_DEFAULT_AGE_DAYS=180
OPERATIONS_PICKUP_PHOTO_BATCH_SIZE=100

CACHE_STORE=database
CACHE_PREFIX=bank_sampah_sindangheula

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APP_INITIAL_ADMIN_USERNAME=
APP_INITIAL_ADMIN_EMAIL=
APP_INITIAL_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Tutorial videos served from the public document root.
# Leave empty to show "Video belum tersedia." on /tutorial-penggunaan.
# Production values:
# TUTORIAL_WARGA_LOGIN_URL=/videos/tutorial/01-warga-akun-dan-saldo.mp4
# TUTORIAL_WARGA_LAYANAN_URL=/videos/tutorial/02-warga-pengajuan-layanan.mp4
# TUTORIAL_PETUGAS_SETORAN_URL=/videos/tutorial/03-petugas-catat-setoran.mp4
# TUTORIAL_PETUGAS_TUGAS_URL=/videos/tutorial/04-petugas-pickup-sembako-keliling.mp4
# TUTORIAL_BENDAHARA_TUNAI_URL=/videos/tutorial/05-bendahara-catat-pembayaran-tunai.mp4
# TUTORIAL_ADMIN_PENGELOLAAN_URL=/videos/tutorial/06-admin-kelola-sistem.mp4
TUTORIAL_WARGA_LOGIN_URL=
TUTORIAL_WARGA_LAYANAN_URL=
TUTORIAL_PETUGAS_SETORAN_URL=
TUTORIAL_PETUGAS_TUGAS_URL=
TUTORIAL_BENDAHARA_TUNAI_URL=
TUTORIAL_ADMIN_PENGELOLAAN_URL=

# Keep Telegram disabled until privacy notice, additive migrations, HTTPS webhook, and scheduler are approved.
# Username is the bot username without @. Never commit/paste the real token into chat.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INLINE_PROCESSING=true
TELEGRAM_INLINE_MESSAGES=2

# Digital withdrawals are research simulations, never real-money payouts.
# Use a separate database ending _sandbox (or disposable bank_sampah_test_*).
PAYOUT_SANDBOX_ENABLED=false
PAYOUT_SANDBOX_DATABASE=
XENDIT_PAYOUT_SECRET_KEY=
XENDIT_PAYOUT_WEBHOOK_TOKEN=
# Confirm these identifiers against the account's v3 dynamic schema.
XENDIT_PAYOUT_ROUTING_BCA=
XENDIT_PAYOUT_ROUTING_MANDIRI=
XENDIT_PAYOUT_ROUTING_BRI=
XENDIT_PAYOUT_ROUTING_BNI=
XENDIT_PAYOUT_ROUTING_DANA=
XENDIT_PAYOUT_ROUTING_GOPAY=
