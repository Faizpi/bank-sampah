# Local development defaults. Do not use this file as a production secret store.
APP_NAME="Bank Sampah Digital Sindangheula"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# Production contract (set in the host's private environment, never commit the values):
# APP_ENV=production
# APP_KEY=<stable-generated-key-stored-out-of-band>
# APP_DEBUG=false
# APP_URL=https://<application-domain>
# APP_TIMEZONE=Asia/Jakarta
# LOG_LEVEL=warning
# DB_CONNECTION=mariadb
# DB_HOST=<managed-database-host>
# DB_PORT=3306
# DB_DATABASE=<application-database>
# DB_USERNAME=<least-privilege-application-user>
# DB_PASSWORD=<database-secret>
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=database
# FILESYSTEM_DISK=local
# QUEUE_CONNECTION=sync
# OPERATIONS_QUEUE_WORKER_MODE=none
# SCHEDULER_TOPOLOGY=cron

# Optional first back-office administrator, consumed only by Database\Seeders\InitialAdminSeeder
# (idempotent, env-gated; skipped when unset). Set BOTH temporarily during first deployment,
# run `php artisan db:seed --class=DatabaseSeeder --force`, then clear these values and rotate
# the password to a user-chosen credential. Never commit real secrets here.
# APP_INITIAL_ADMIN_EMAIL=
# APP_INITIAL_ADMIN_PASSWORD=


APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bank_sampah_sindangheula
DB_USERNAME=bank_sampah_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

REGISTRATION_MAX_ATTEMPTS_PER_MINUTE=5
PUBLIC_QR_MAX_ATTEMPTS_PER_MINUTE=30
PUBLIC_DATA_MAX_ATTEMPTS_PER_MINUTE=120
UPLOAD_MAX_ATTEMPTS_PER_MINUTE=10
EXPORT_MAX_ATTEMPTS_PER_MINUTE=10
FINANCIAL_REQUEST_MAX_ATTEMPTS_PER_MINUTE=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
DB_QUEUE_MAX_JOBS=25
DB_QUEUE_MAX_TIME=55
DB_QUEUE_TRIES=3
OPERATIONS_SCHEDULER_BATCH_SIZE=50
OPERATIONS_NOTIFICATION_FAILURE_RETENTION_HOURS=168

CACHE_STORE=database
CACHE_PREFIX=bank_sampah_sindangheula

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
